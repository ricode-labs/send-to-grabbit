{
  "manifest_version": 3,
  "name": "Send to Grabbit",
  "description": "Intercept browser downloads and send them to Grabbit with available request metadata.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["cookies", "downloads", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
